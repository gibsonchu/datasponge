{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "datasponge.vercel.app"
        }
      ],
      "destination": "https://datasponge.floodline.nyc/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "flood-commons.vercel.app"
        }
      ],
      "destination": "https://datasponge.floodline.nyc/:path*",
      "permanent": true
    },
    {
      "source": "/workspace",
      "destination": "/editor/",
      "permanent": true
    },
    {
      "source": "/workspace/(.*)",
      "destination": "/editor/",
      "permanent": true
    },
    {
      "source": "/editor",
      "destination": "/editor/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/editor/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/autofill.js": {
      "maxDuration": 120
    },
    "api/source-read.js": {
      "maxDuration": 300
    },
    "api/answer.js": {
      "maxDuration": 180
    },
    "api/describe-story.js": {
      "maxDuration": 60
    }
  }
}
